# ============================================================
# PakMind Unified Backend — Environment Variables Template
# Copy this file to .env and fill in your credentials
# ============================================================

# Supabase (shared PakMind database)
# Get from your Supabase dashboard: Settings → API
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
# Service-role key for PakScholar write operations
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Google Gemini API Key (FREE — primary LLM + embeddings)
# Get your free key here: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key
# Optional backup key for 429 quota rotation (from a different Google project)
GOOGLE_API_KEY_2=

# Groq API Key (FREE — verification LLM)
# Get your free key here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Serper.dev API Key (FREE — Google search for web fallback)
# Get your free key here: https://serper.dev/
SERPER_API_KEY=your_serper_api_key

# OpenAI (OPTIONAL — paid fallback, leave blank if using free tier)
# OPENAI_API_KEY=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
